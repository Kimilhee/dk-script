{
  "name": "dk-script",
  "version": "0.0.0",
  "description": "On-device handwritten math recognition constraint-decoding prototype.",
  "homepage": "https://kimilhee.github.io/dk-script/",
  "bugs": {
    "url": "https://github.com/Kimilhee/dk-script/issues"
  },
  "license": "MIT",
  "author": "Kimilhee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kimilhee/dk-script.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "poc": "vp dev prototype/constraint-decoding --host 0.0.0.0",
    "poc:build": "vp build prototype/constraint-decoding",
    "poc:prepare": "node prototype/constraint-decoding/scripts/prepare-assets.mjs",
    "poc:batch": "node prototype/constraint-decoding/scripts/batch.ts",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.30.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
